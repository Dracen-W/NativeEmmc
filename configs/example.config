# NativeEmmc example configuration (values intentionally blank).
# Copy or override these keys in your board/OS config (e.g. UniXNU-merlinx/configs/merlinx-iOS16.7.config).
# At build time, UniXNU-merlinx merges SoC -> defconfig -> OS config and passes -DCONFIG_XNU_DW_NATIVEEMMC_*.
#
# Supported parameters:
#
# APFS OS root volume UUID recognized as the "OS" window (36-char uppercase UUID).
# Default if unset: falls back to CONFIG_XNU_DW_APFS_OS_UUID, then "04769D26-2CA0-4825-B443-E2E5F88300F2" (iPadOS 17.7.11).
# Example (iOS 16.7.16 20H392): "DADD93F8-DBBF-4B17-A1DF-0F11E64172F7"
CONFIG_XNU_DW_NATIVEEMMC_OS_UUID=""

# APFS SystemOS / Cryptex cache volume UUID recognized as the "SystemOS" window.
# Default if unset: falls back to CONFIG_XNU_DW_APFS_SYSTEMOS_UUID, then "8846FE78-2910-4297-AF97-D59BB6F8FC16" (iPadOS 17.7.11).
# Example (iOS 16.7.16 20H392): "96096B28-B6DC-4BC7-9D3A-2632A0FE53F1"
CONFIG_XNU_DW_NATIVEEMMC_SYSTEMOS_UUID=""

# Optional secondary OS / SystemOS UUIDs (for dual-OS compatibility in a single binary).
CONFIG_XNU_DW_NATIVEEMMC_EXTRA_OS_UUID=""
CONFIG_XNU_DW_NATIVEEMMC_EXTRA_SYSTEMOS_UUID=""

# Maximum 512-byte blocks per MSDC0 transfer chunk (integer; default: 2048 = 1 MiB).
CONFIG_XNU_DW_NATIVEEMMC_TRANSFER_BLOCKS=

# Spin-yield iterations before sleeping with IODelay during FIFO/status polling (integer; default: 4096).
CONFIG_XNU_DW_NATIVEEMMC_SPIN_POLLS=

# Starting 512-byte LBA and byte length of the userdata partition window (integers; defaults: 20332544 / 114597789696).
CONFIG_XNU_DW_NATIVEEMMC_USERDATA_LBA=
CONFIG_XNU_DW_NATIVEEMMC_USERDATA_BYTES=
